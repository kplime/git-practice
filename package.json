{
  "name": "git-practice",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kplime/git-practice.git"
  },
  "description": "온가드(OnGuard) — Wi‑Fi 센싱 기반 비촬영 생활안전 보조 시스템 · 팀 부캉이",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "setup": "node scripts/setup-env.js",
    "db:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-db.ps1",
    "db:rename": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/rename-db.ps1",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "test:integration": "node --env-file-if-exists=.env scripts/test-integration.js",
    "test:ui": "node --test tests/ui.test.js",
    "test:db-rename": "node --test tests/db-rename.test.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "demo:seed": "node --env-file-if-exists=.env scripts/demo.js --seed-only"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
